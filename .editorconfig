# Editor defaults for the files Biome doesn't format — GitHub workflows,
# Dependabot config, shell scripts, Markdown. `bun run check` remains the
# authority on everything under src/.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown; trimming them silently
# reflows the paragraph.
trim_trailing_whitespace = false
